___TESTS___

scenarios:
- name: Sets regional defaults and loads COKIQ
  code: |-
    const mockData = {
      siteKey: 'cs_test',
      regionRule: 'eea_uk_ch',
      ad_storage: 'denied',
      analytics_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      outsideDefault: 'granted',
      waitForUpdate: '500',
      adsDataRedaction: true,
      urlPassthrough: true
    };
    let defaultsCalls = [];
    mock('setDefaultConsentState', (s) => { defaultsCalls.push(s); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    runCode(mockData);
    assertThat(defaultsCalls.length).isEqualTo(2);
    assertThat(defaultsCalls[0].ad_storage).isEqualTo('granted');
    assertThat(defaultsCalls[0].region).isUndefined();
    assertThat(defaultsCalls[1].ad_storage).isEqualTo('denied');
    assertThat(defaultsCalls[1].ad_user_data).isEqualTo('denied');
    assertThat(defaultsCalls[1].ad_personalization).isEqualTo('denied');
    assertThat(defaultsCalls[1].analytics_storage).isEqualTo('denied');
    assertThat(defaultsCalls[1].wait_for_update).isEqualTo(500);
    assertThat(defaultsCalls[1].region).contains('DE');
    assertThat(defaultsCalls[1].region).contains('GB');
    assertApi('gtagSet').wasCalledWith({ads_data_redaction: true, url_passthrough: true});
    assertApi('gtagSet').wasCalledWith({'developer_id.dZjc5MD': true});
    assertApi('setInWindow').wasCalledWith('__cokiqDeveloperIdSet', true, true);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: All regions sets one denied default
  code: |-
    let defaultsCalls = [];
    mock('setDefaultConsentState', (s) => { defaultsCalls.push(s); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    runCode({ siteKey: 'cs_test', regionRule: 'all', waitForUpdate: '0', adsDataRedaction: false, urlPassthrough: false });
    assertThat(defaultsCalls.length).isEqualTo(1);
    assertThat(defaultsCalls[0].ad_storage).isEqualTo('denied');
    assertThat(defaultsCalls[0].region).isUndefined();
    assertThat(defaultsCalls[0].wait_for_update).isUndefined();
    assertApi('gtagSet').wasCalledWith({ads_data_redaction: false, url_passthrough: false});
- name: Custom regions are parsed
  code: |-
    let defaultsCalls = [];
    mock('setDefaultConsentState', (s) => { defaultsCalls.push(s); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    runCode({ siteKey: 'cs_test', regionRule: 'custom', customRegions: ' us-ca, br ,', outsideDefault: 'denied', waitForUpdate: '500' });
    assertThat(defaultsCalls.length).isEqualTo(2);
    assertThat(defaultsCalls[0].ad_storage).isEqualTo('denied');
    assertThat(defaultsCalls[1].region).isEqualTo(['US-CA', 'BR']);
- name: Returning visitor choice is passed with updateConsentState
  code: |-
    let updates = [];
    mock('updateConsentState', (s) => { updates.push(s); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    mock('callInWindow', (name, arg) => {
      if (name === 'Cokiq.getConsent') return { choices: { necessary: true, analytics: true, marketing: false, preferences: true } };
      return undefined;
    });
    runCode({ siteKey: 'cs_test', regionRule: 'all' });
    assertThat(updates.length).isEqualTo(1);
    assertThat(updates[0].analytics_storage).isEqualTo('granted');
    assertThat(updates[0].ad_storage).isEqualTo('denied');
    assertThat(updates[0].ad_user_data).isEqualTo('denied');
    assertThat(updates[0].ad_personalization).isEqualTo('denied');
    assertThat(updates[0].functionality_storage).isEqualTo('granted');
- name: Later visitor choice goes through the consent listener
  code: |-
    let updates = [];
    let listener;
    mock('updateConsentState', (s) => { updates.push(s); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    mock('callInWindow', (name, arg) => {
      if (name === 'Cokiq.addConsentListener') listener = arg;
      return undefined;
    });
    runCode({ siteKey: 'cs_test', regionRule: 'all' });
    assertThat(updates.length).isEqualTo(0);
    listener({ necessary: true, analytics: false, marketing: true, preferences: false });
    assertThat(updates.length).isEqualTo(1);
    assertThat(updates[0].ad_storage).isEqualTo('granted');
    assertThat(updates[0].ad_user_data).isEqualTo('granted');
    assertThat(updates[0].ad_personalization).isEqualTo('granted');
    assertThat(updates[0].analytics_storage).isEqualTo('denied');
- name: Script load failure calls gtmOnFailure
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => { onFailure(); });
    runCode({ siteKey: 'cs_test', regionRule: 'all' });
    assertApi('setDefaultConsentState').wasCalled();
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Fails without site key
  code: |-
    runCode({ siteKey: '', regionRule: 'all' });
    assertApi('gtmOnFailure').wasCalled();
    assertApi('injectScript').wasNotCalled();
    assertApi('setDefaultConsentState').wasNotCalled();


